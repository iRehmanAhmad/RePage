{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RePage",
  "version": "0.1.0",
  "identifier": "com.repage.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "RePage — Urdu Document Publishing System",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "deb", "appimage", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Office",
    "shortDescription": "Authentic Urdu Document Publishing System",
    "longDescription": "RePage is an offline-first frame-oriented desktop publishing system tailored for authentic Urdu Nastaliq and complex multi-lingual document production.",
    "copyright": "Copyright © 2026 RePage Contributors",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signing": {
        "entitlements": null
      }
    },
    "linux": {
      "deb": {
        "depends": ["webkit2gtk-4.1", "fontconfig", "libssl3"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "fontconfig", "openssl"]
      }
    },
    "fileAssociations": [
      {
        "ext": ["urdup"],
        "name": "RePage Urdu Document",
        "description": "RePage Urdu Document Package",
        "mimeType": "application/vnd.urdup+zip",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IFJFUEFHRV9TRUNVUkVfS0VZ",
      "endpoints": [
        "https://releases.repage.org/stable/update.json",
        "https://releases.repage.org/beta/update.json"
      ]
    }
  }
}
